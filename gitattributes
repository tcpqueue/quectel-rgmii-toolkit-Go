# Auto-detect text files and normalize them in the repository
* text=auto

# Windows scripts: keep CRLF in working tree
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Unix/Linux shell scripts: keep LF to avoid /bin/sh^M errors
*.sh text eol=lf

# Go backend
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Frontend / web files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Docs
*.md text eol=lf
*.txt text eol=lf

# Configs commonly used on Linux/module side
*.service text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.env text eol=lf

# Keep binaries untouched
*.exe binary
*.dll binary
*.so binary
*.a binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
